# Local e Preview usam SABENCA-DEV; Production usa SABENCA-PROD.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: localhost. Production: URL HTTPS real. Preview usa VERCEL_URL/VERCEL_BRANCH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INSTITUTION_NAME=Comunidade FATECE
# Somente no servidor. Nunca prefixar estas variáveis com NEXT_PUBLIC_.
# Transaction pooler (porta 6543) do MESMO projeto da URL Supabase acima.
# Codifique caracteres especiais da senha na URI. Nunca reutilize PROD em Preview.
DATABASE_URL=
# Caminho do certificado CA baixado em Database Settings > SSL Configuration.
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
SUPABASE_SECRET_KEY=
# Dois segredos independentes de pelo menos 32 bytes, diferentes em DEV e PROD.
# Preserve os existentes no DEV. Não alterar sem migração dos fingerprints.
CPF_HMAC_SECRET=
AUTH_HMAC_SECRET=
