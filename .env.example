NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INSTITUTION_NAME=Comunidade FATECE
# Somente no servidor. Nunca prefixar estas variáveis com NEXT_PUBLIC_.
# URL PostgreSQL/Supavisor com TLS verificado; use a conexão do projeto SABENÇA.
DATABASE_URL=
# Caminho do certificado CA baixado em Database Settings > SSL Configuration.
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
SUPABASE_SECRET_KEY=
# Dois segredos independentes de pelo menos 32 bytes. Não alterar sem migração dos fingerprints.
CPF_HMAC_SECRET=
AUTH_HMAC_SECRET=
